{
  "workspace": {
    "statuses": [
      { "id": "todo", "label": "Todo", "color": "neutral", "icon": "circle" },
      { "id": "in-progress", "label": "In progress", "color": "conductor-progress", "icon": "conductor-progress" },
      { "id": "in-review", "label": "In review", "color": "conductor-review", "icon": "conductor-review" },
      { "id": "completed", "label": "Done", "color": "conductor-done", "icon": "conductor-done" }
    ],
    "cardFields": ["status", "unread", "issue", "linear-issue", "jira-issue", "pr", "automation", "cli", "comment", "ports", "inline-agents", "host", "project"],
    "boardOpacity": 1,
    "boardColumnWidth": 308
  },
  "sidebar": {
    "groupBy": "repo",
    "sortBy": "recent",
    "projectOrderBy": "manual"
  },
  "rules": {
    "pr": {
      "enabled": false,
      "statusByCondition": {},
      "mergingCheckName": "Reviews satisfied",
      "newWorkspaceStatus": null,
      "holdStatus": null,
      "pmApprovalTeam": null,
      "onResolved": "none",
      "onReviewed": "none",
      "resolveConflictsWithAgent": false,
      "conflictPromptTemplate": "",
      "reviewEnteredCommand": "",
      "actionPrompts": {},
      "reviewInbox": {
        "enabled": false,
        "agent": "claude",
        "view": "chat"
      }
    }
  },
  "quickCommands": [],
  "sourceControl": {
    "openIn": [{ "id": "vscode", "label": "VS Code", "command": "code" }]
  },
  "theme": {
    "mode": "system"
  }
}
